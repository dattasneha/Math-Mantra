<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".ui.DrawShapesFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.zendalona.mathmantra.ui.DrawCanvas
            android:id="@+id/drawing_view"
            android:layout_width="280dp"
            android:layout_height="280dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="@color/black"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/recognize_shape_button" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/recognize_shape_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Check"
            android:layout_below="@id/draw_shape_tv"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="8dp"
            android:layout_alignParentStart="true"
            app:layout_constraintBottom_toTopOf="@id/draw_shape_tv"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="@id/clear_button"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/clear_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Clear"
            android:layout_below="@id/draw_shape_tv"
            android:layout_marginTop="16dp"
            android:layout_marginStart="8dp"
            android:layout_alignParentStart="true"
            app:layout_constraintBottom_toTopOf="@id/draw_shape_tv"
            app:layout_constraintStart_toStartOf="@id/recognize_shape_button"
            app:layout_constraintEnd_toEndOf="parent"/>

        <com.zendalona.mathmantra.utils.StatusTextView
            android:id="@+id/draw_shape_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:clickable="false"
            android:focusable="false"
            android:text="Draw a Shape"
            android:textAlignment="center"
            android:textSize="48sp"
            app:layout_constraintBottom_toTopOf="@+id/mole_up_siv"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginBottom="50dp"/>

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/mole_up_siv"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_marginTop="20dp"
            android:clickable="false"
            android:focusable="false"
            android:src="@drawable/molepointingup"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginBottom="50dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>